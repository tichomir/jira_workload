# =============================================================================
# jira_workload — Deployment Environment Configuration
# =============================================================================
# Copy this file to .env in the project root and fill in real values.
#
#   cp config/deployment.env.example .env
#
# NEVER commit .env to version control — it contains secrets.
# All values in this file are PLACEHOLDERS only.
#
# Cross-platform path notes:
#   - All file paths in this file use forward-slash (/) notation.
#   - On Windows (non-WSL): substitute backslashes (\) where required by your
#     shell. When running under WSL2, forward slashes work natively.
#   - Podman and Node.js path.join() normalise separators automatically on all
#     platforms; prefer forward slashes in mounted volume paths.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# TCP port the Express server listens on.
# Accepted values: any integer 1024–65535
# Default if unset: 4000
PORT=4000

# Runtime environment.
# Accepted values: development | production | test
# NOTE: Hard Delete is ONLY permitted when NODE_ENV != 'production' AND
#       ALLOW_HARD_DELETE=true. Never set both in production.
NODE_ENV=development


# -----------------------------------------------------------------------------
# Atlassian OAuth 2.0 (3LO) Credentials
# -----------------------------------------------------------------------------
# Obtain from: https://developer.atlassian.com/console/myapps/
# Register a new app, add OAuth 2.0 (3LO), and copy the credentials below.

# OAuth app client ID (public identifier — safe to share, but keep out of logs).
ATLASSIAN_CLIENT_ID=your-atlassian-client-id-here

# OAuth app client secret (treat as a password — never log or expose).
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret-here

# OAuth redirect URI registered in the Atlassian Developer Console.
#
# ⚠️  IMPORTANT — Atlassian requires an HTTPS callback URL.
# Using http://localhost will result in a "Redirect URI must be a valid HTTPS URL" error.
#
# For local development you must use an HTTPS tunnel or local proxy.
# See OAUTH_SETUP.md § 2a for the full guide. Quick options:
#
#   Option A (ngrok — recommended):
#     1. Run: ngrok http 4000
#     2. Copy the https://....ngrok-free.app URL shown
#     3. Set: ATLASSIAN_REDIRECT_URI=https://<your-id>.ngrok-free.app/oauth/callback
#
#   Option B (Caddy + mkcert — offline):
#     Set: ATLASSIAN_REDIRECT_URI=https://localhost:4443/oauth/callback
#     (requires Caddy sidecar setup — see OAUTH_SETUP.md § 2a Option B)
#
# For production: set to your deployed HTTPS callback endpoint.
#
ATLASSIAN_REDIRECT_URI=https://replace-with-your-ngrok-or-https-url/oauth/callback


# -----------------------------------------------------------------------------
# Application Base URLs
# -----------------------------------------------------------------------------

# Public base URL of this application (no trailing slash).
# Used to construct webhook callback URLs and internal redirects.
# Windows WSL2: use the WSL2 IP if exposing beyond localhost, e.g. http://172.x.x.x:4000
APP_BASE_URL=http://localhost:4000

# Base URL of the frontend application (no trailing slash).
# Used by the OAuth callback handler to redirect the browser after authentication.
# If the backend serves the frontend (default local setup), set to the same as APP_BASE_URL.
FRONTEND_BASE_URL=http://localhost:4000


# -----------------------------------------------------------------------------
# Token Encryption
# -----------------------------------------------------------------------------

# 32-byte (256-bit) AES-256-GCM master key, hex-encoded (64 hex characters).
# Used to encrypt OAuth access and refresh tokens at rest.
#
# Generate a new key:
#   macOS / Linux:  openssl rand -hex 32
#   Windows CMD:    certutil -f -encodehex %TEMP%\rnd.bin %TEMP%\key.hex 0x4000 & type %TEMP%\key.hex
#   Windows PowerShell: -join ((1..32 | % { '{0:x2}' -f (Get-Random -Max 256) }))
#   Node.js (any platform): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED — server will refuse to start if missing or not exactly 64 hex chars.
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-string-generated-above


# -----------------------------------------------------------------------------
# OAuth State Management
# -----------------------------------------------------------------------------

# Lifetime (in seconds) of a pending OAuth state token before it expires.
# Accepted values: positive integer
# Default if unset: 600 (10 minutes)
OAUTH_STATE_TTL_SECONDS=600


# -----------------------------------------------------------------------------
# Integration Lifecycle
# -----------------------------------------------------------------------------

# Days of data retained after a Soft Delete before permanent removal.
# Accepted values: positive integer
# Default if unset: 30
INTEGRATION_SOFT_DELETE_RETENTION_DAYS=30

# Enable Hard Delete (permanent, immediate data removal).
# ONLY set to 'true' in non-production / sandbox environments.
# Accepted values: true | false
# Default if unset: false (Hard Delete is blocked)
ALLOW_HARD_DELETE=false


# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------

# Full URL Atlassian will POST Jira webhook events to.
# Must be publicly reachable by Atlassian cloud (use ngrok or similar for local dev).
#
# macOS / Linux local tunnel example:
#   ngrok http 4000   → copy the https URL and append /webhooks/jira
#
# Windows local tunnel (WSL2): same as above; expose via WSL2 localhost forwarding.
#
# Default if unset: {APP_BASE_URL}/webhooks/jira
WEBHOOK_CALLBACK_URL=https://your-public-hostname.example.com/webhooks/jira


# -----------------------------------------------------------------------------
# Storage Paths  (relative paths use forward-slash; absolute paths documented below)
# -----------------------------------------------------------------------------
# The current implementation uses an in-memory store (src/db/index.js).
# These variables are reserved for the production database/storage layer.
#
# Path conventions:
#   macOS / Linux:   /var/data/jira-workload/backups
#   Windows native:  C:/ProgramData/jira-workload/backups   (forward-slash OK in Node.js)
#   Windows WSL2:    /mnt/c/ProgramData/jira-workload/backups
#   Podman volume:   /app/data/backups   (host path mapped via podman-compose volumes)

# Root directory for backup binary storage (attachments, exports).
# Default if unset: ./data/backups  (relative to project root, created on first use)
BACKUP_STORAGE_PATH=./data/backups

# Root directory for SDI scan temporary extraction files.
# Must be on a local fast disk; cleared after each scan run.
# Default if unset: ./data/sdi-tmp
SDI_TMP_PATH=./data/sdi-tmp

# Root directory for restore export archives (JSON + ZIP downloads).
# Default if unset: ./data/exports
EXPORT_ARCHIVE_PATH=./data/exports


# -----------------------------------------------------------------------------
# Database Connection  (reserved for production — in-memory store used by default)
# -----------------------------------------------------------------------------
# Uncomment and populate when replacing src/db/index.js with a real database.
#
# PostgreSQL example:
#   DATABASE_URL=postgresql://jira_workload_user:password@localhost:5432/jira_workload
#
# Connection pool size (optional, default: 10):
#   DATABASE_POOL_SIZE=10
#
# Path conventions for socket-based connections:
#   macOS / Linux:   /var/run/postgresql/.s.PGSQL.5432
#   Windows:         Not applicable — use TCP (host:port) instead

# DATABASE_URL=postgresql://jira_workload_user:change_me@localhost:5432/jira_workload
# DATABASE_POOL_SIZE=10
