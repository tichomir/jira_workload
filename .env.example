# =============================================================================
# jira_workload — Environment Configuration
# =============================================================================
# Copy this file to .env in the project root, then fill in real values.
#
#   macOS / Linux:  cp .env.example .env
#   Windows CMD:    copy .env.example .env
#   Windows PS:     Copy-Item .env.example .env
#
# NEVER commit .env to version control — it contains secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

PORT=4000
NODE_ENV=development


# -----------------------------------------------------------------------------
# Atlassian OAuth 2.0 (3LO) Credentials
# -----------------------------------------------------------------------------
# Obtain from: https://developer.atlassian.com/console/myapps/
# Register a new app → OAuth 2.0 (3LO) → copy Client ID and Secret below.

ATLASSIAN_CLIENT_ID=your-atlassian-client-id-here
ATLASSIAN_CLIENT_SECRET=your-atlassian-client-secret-here

# Must match the Redirect URI configured in the Atlassian Developer Console.
# For local development: http://localhost:4000/oauth/callback
ATLASSIAN_REDIRECT_URI=http://localhost:4000/oauth/callback


# -----------------------------------------------------------------------------
# Application Base URLs
# -----------------------------------------------------------------------------

APP_BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:4000


# -----------------------------------------------------------------------------
# Token Encryption  (REQUIRED)
# -----------------------------------------------------------------------------
# 32-byte AES-256-GCM key, hex-encoded (exactly 64 hex characters).
#
# Generate a new key (choose one):
#   macOS / Linux:    openssl rand -hex 32
#   Windows PS:       -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
#   Node.js (any):    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-character-string-generated-above


# -----------------------------------------------------------------------------
# OAuth State Management
# -----------------------------------------------------------------------------

OAUTH_STATE_TTL_SECONDS=600


# -----------------------------------------------------------------------------
# Integration Lifecycle
# -----------------------------------------------------------------------------

INTEGRATION_SOFT_DELETE_RETENTION_DAYS=30
ALLOW_HARD_DELETE=false


# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
# Must be publicly reachable by Atlassian cloud.
# Use ngrok or similar for local dev: ngrok http 4000
# Then set: WEBHOOK_CALLBACK_URL=https://<ngrok-id>.ngrok.io/webhooks/jira

WEBHOOK_CALLBACK_URL=https://your-public-hostname.example.com/webhooks/jira


# -----------------------------------------------------------------------------
# Storage Paths
# -----------------------------------------------------------------------------
# Relative paths are relative to the project root.
# When using Docker these paths map to named volumes (see docker-compose.yml).

BACKUP_STORAGE_PATH=./data/backups
SDI_TMP_PATH=./data/sdi-tmp
EXPORT_ARCHIVE_PATH=./data/exports


# -----------------------------------------------------------------------------
# Database Connection  (reserved — in-memory store used by default)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://jira_workload_user:change_me@localhost:5432/jira_workload
# DATABASE_POOL_SIZE=10
